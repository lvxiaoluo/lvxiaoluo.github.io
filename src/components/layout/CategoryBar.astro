---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { getCategoryTree } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const categoryTree = await getCategoryTree();
const totalPosts = categoryTree.reduce((sum, n) => sum + n.totalCount, 0);
const homeUrl = url("/");
const archiveUrl = url("/archive/");
---

<div class="card-base category-bar p-3 onload-animation" id="category-bar" data-home-path={homeUrl} data-archive-path={archiveUrl} data-active-dropdown="">
  <div class="category-bar-inner flex gap-2">
    <a
      href={homeUrl}
      class="category-pill text-sm px-2 py-1 rounded-lg flex-shrink-0
             transition-colors duration-200 flex items-center justify-center"
      data-category-name=""
      aria-label={i18n(I18nKey.home)}
    >
      <Icon name="material-symbols:home" class="text-lg" />
    </a>
    <a
      href={archiveUrl}
      class="category-pill text-sm px-3 py-1 rounded-lg whitespace-nowrap flex-shrink-0
             transition-colors duration-200 flex items-center justify-center"
      data-category-name="__archive__"
    >
      {i18n(I18nKey.archive)}
      <span class="text-xs opacity-60 ml-1">{totalPosts}</span>
    </a>
    <div class="category-divider flex-shrink-0"></div>
    <div class="scroll-area relative">
      <div class="scroll-fade scroll-fade-left" aria-hidden="true"></div>
      <div class="category-scroll flex gap-2 overflow-x-auto">
        {
          categoryTree.map((cat) => (
            <div class="category-item flex-shrink-0" data-name={cat.name}>
              <a
                href={cat.url}
                class:list={[
                  "category-pill text-sm px-3 py-1 rounded-lg whitespace-nowrap",
                  "transition-colors duration-200 flex items-center justify-center",
                  { "has-children": cat.children.length > 0 },
                ]}
                data-category-name={cat.name}
                data-category-path={JSON.stringify(cat.path)}
              >
                {cat.name}
                <span class="text-xs opacity-60 ml-1">{cat.totalCount}</span>
                {cat.children.length > 0 && (
                  <Icon name="material-symbols:expand-more-rounded" class="text-sm ml-0.5 opacity-50 dropdown-arrow" />
                )}
              </a>
            </div>
          ))
        }
      </div>
      <div class="scroll-fade scroll-fade-right" aria-hidden="true"></div>
    </div>
  </div>
  <div class="category-dropdown-panel">
    {categoryTree.filter((c) => c.children.length > 0).map((cat) => (
      <div class="dropdown-content" data-dropdown={cat.name}>
        <div class="dropdown-tree">
          {cat.children.map((c1) => (
            <div class:list={["tree-node", { "has-children": c1.children.length > 0 }]}>
              <div class="tree-node-header">
                <a
                  href={c1.url}
                  class="category-dropdown-pill"
                  data-category-name={c1.name}
                  data-category-path={JSON.stringify(c1.path)}
                >
                  <span>{c1.name}</span>
                  <span class="text-xs opacity-60 ml-1">{c1.totalCount}</span>
                </a>
                {c1.children.length > 0 && (
                  <button class="tree-toggle" type="button" aria-label="Toggle submenu">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </button>
                )}
              </div>
              {c1.children.length > 0 && (
                <div class="tree-children">
                  {c1.children.map((c2) => (
                    <div class:list={["tree-node", { "has-children": c2.children.length > 0 }]}>
                      <div class="tree-node-header">
                        <a
                          href={c2.url}
                          class="category-dropdown-pill"
                          data-category-name={c2.name}
                          data-category-path={JSON.stringify(c2.path)}
                        >
                          <span>{c2.name}</span>
                          <span class="text-xs opacity-60 ml-1">{c2.totalCount}</span>
                        </a>
                        {c2.children.length > 0 && (
                          <button class="tree-toggle" type="button" aria-label="Toggle submenu">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                          </button>
                        )}
                      </div>
                      {c2.children.length > 0 && (
                        <div class="tree-children">
                          {c2.children.map((c3) => (
                            <div class="tree-node">
                              <div class="tree-node-header">
                                <a
                                  href={c3.url}
                                  class="category-dropdown-pill"
                                  data-category-name={c3.name}
                                  data-category-path={JSON.stringify(c3.path)}
                                >
                                  <span>{c3.name}</span>
                                  <span class="text-xs opacity-60 ml-1">{c3.totalCount}</span>
                                </a>
                              </div>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .category-bar {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    max-height: 3.5rem;
    transition: max-height 0.3s ease;
    overflow: hidden;
  }
  .category-bar[data-active-dropdown]:not([data-active-dropdown=""]) {
    max-height: 500px;
  }
  .category-divider {
    width: 1px;
    align-self: stretch;
    background: var(--line-divider);
  }
  .scroll-area {
    flex: 1;
    min-width: 0;
    position: relative;
  }
  .scroll-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease-in-out;
    z-index: 1;
  }
  .scroll-fade[data-visible] {
    opacity: 1;
  }
  .scroll-fade-left {
    left: 0;
    background: linear-gradient(to left, transparent, var(--card-bg));
  }
  .scroll-fade-right {
    right: 0;
    background: linear-gradient(to right, transparent, var(--card-bg));
  }
  :global(body.wallpaper-transparent) .scroll-fade {
    display: none;
  }
  .category-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .category-scroll::-webkit-scrollbar {
    display: none;
  }
  .category-pill {
    border: 1.5px solid var(--line-divider);
    color: var(--btn-content);
    background: transparent;
  }
  .category-pill:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: transparent;
  }
  .category-pill[data-active] {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }
  .category-pill[data-active]:hover {
    background: var(--primary);
    border-color: var(--primary);
    opacity: 0.9;
  }
  .category-item {
    display: flex;
    flex-shrink: 0;
  }
  .category-pill.has-children {
    transition: border-color 200ms ease, color 200ms ease;
  }
  .dropdown-arrow {
    transition: transform 200ms ease;
  }
  .category-item[data-hovered] .dropdown-arrow {
    transform: rotate(180deg);
  }
  .category-item[data-hovered] .category-pill.has-children {
    border-color: var(--primary);
    color: var(--primary);
  }
  .category-item[data-hovered] .category-pill[data-active] {
    color: white;
  }
  /* Dropdown panel - sits inside card, below pill row */
  .category-dropdown-panel {
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--line-divider) transparent;
  }
  .category-dropdown-panel::-webkit-scrollbar {
    width: 4px;
  }
  .category-dropdown-panel::-webkit-scrollbar-track {
    background: transparent;
  }
  .category-dropdown-panel::-webkit-scrollbar-thumb {
    background: var(--line-divider);
    border-radius: 2px;
  }
  .dropdown-content {
    display: none;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line-divider);
  }
  .category-bar[data-active-dropdown=""] .dropdown-content {
    display: none;
  }
  .dropdown-tree {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.25rem 0;
  }
  .tree-node-header {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .tree-node-header > .category-dropdown-pill {
    flex: 1;
    min-width: 0;
  }
  .tree-children {
    display: none;
    flex-direction: column;
    gap: 0.125rem;
    padding-left: 1rem;
    border-left: 2px solid var(--line-divider);
    margin-left: 0.625rem;
    margin-top: 0.125rem;
    margin-bottom: 0.125rem;
  }
  .tree-node[data-expanded] > .tree-children {
    display: flex;
  }
  .tree-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.625rem;
    height: 1.625rem;
    flex-shrink: 0;
    border: none;
    background: transparent;
    color: var(--btn-content);
    opacity: 0.4;
    cursor: pointer;
    border-radius: 0.375rem;
    transition: all 150ms ease;
    padding: 0;
  }
  .tree-toggle:hover {
    background: var(--btn-regular-bg);
    opacity: 0.8;
  }
  .tree-node[data-expanded] > .tree-node-header > .tree-toggle {
    transform: rotate(90deg);
    opacity: 0.7;
  }
  .category-dropdown-pill {
    display: flex;
    align-items: center;
    padding: 0.375rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    white-space: nowrap;
    color: var(--btn-content);
    background: transparent;
    border: 1px solid transparent;
    transition: all 150ms ease;
    text-decoration: none;
  }
  .category-dropdown-pill:hover {
    background: var(--btn-regular-bg);
    border-color: var(--line-divider);
  }
  .category-dropdown-pill[data-active] {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }
</style>

<script>
  function updateCategoryBar() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    const pathname = window.location.pathname.replace(/\/$/, "");
    const homePath = (bar.getAttribute("data-home-path") || "/").replace(/\/$/, "");
    const archivePath = (bar.getAttribute("data-archive-path") || "/archive").replace(/\/$/, "");
    const isHome = pathname === homePath || pathname === "" || pathname === "/";
    const isArchive = pathname === archivePath;
    // 分页页面（如 /2/, /3/）也属于首页的延续
    const isHomePagination = /^\/\d+$/.test(pathname) || (homePath !== "" && new RegExp("^" + homePath.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + "\\/\\d+$").test(pathname));

    // 在首页、首页分页和归档页显示
    if (!isHome && !isHomePagination && !isArchive) {
      bar.style.display = "none";
      return;
    }
    bar.style.display = "";

    // 高亮当前分类 - support multi-level via multiple ?category= params
    const pills = bar.querySelectorAll<HTMLAnchorElement>(".category-pill");
    const dropdownPills = bar.querySelectorAll<HTMLAnchorElement>(".category-dropdown-pill");
    const params = new URLSearchParams(window.location.search);
    const activeCategoryPath = params.has("category") ? params.getAll("category") : [];
    const hasTag = params.has("tag");
    const hasUncategorized = params.has("uncategorized");

    pills.forEach((pill) => pill.removeAttribute("data-active"));
    dropdownPills.forEach((pill) => pill.removeAttribute("data-active"));

    if (isHome || isHomePagination) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name=""]')
        ?.setAttribute("data-active", "");
    } else if (activeCategoryPath.length > 0) {
      // Match against data-category-path (JSON stringified array)
      const activePathJson = JSON.stringify(activeCategoryPath);
      const allPills = [...pills, ...dropdownPills];

      // Find and highlight the exact matching pill
      let matchedPill: Element | null = null;
      allPills.forEach((pill) => {
        if (pill.getAttribute("data-category-path") === activePathJson) {
          pill.setAttribute("data-active", "");
          matchedPill = pill;
        }
      });

      // Walk up the DOM from the matched pill and highlight all ancestor category pills
      if (matchedPill) {
        const startPill = matchedPill as Element;
        let el: Element | null = startPill.closest(".tree-node");
        while (el) {
          const parentChildren = el.closest(".tree-children");
          if (!parentChildren) break;
          const parentNode = parentChildren.closest(".tree-node");
          if (!parentNode) break;
          const parentPill = parentNode.querySelector<HTMLAnchorElement>(":scope > .tree-node-header > .category-dropdown-pill");
          if (parentPill) {
            parentPill.setAttribute("data-active", "");
          }
          // Auto-expand ancestor tree nodes for active category
          parentNode.setAttribute("data-expanded", "");
          el = parentNode.closest(".tree-node");
        }

        // Highlight the top-level pill in the scroll row
        const dropdownContent = startPill.closest(".dropdown-content");
        if (dropdownContent) {
          const dropdownName = dropdownContent.getAttribute("data-dropdown");
          pills.forEach((pill) => {
            if (pill.getAttribute("data-category-name") === dropdownName) {
              pill.setAttribute("data-active", "");
            }
          });
        }
      }

      // Also highlight top-level pill if path starts with its name
      if (activeCategoryPath.length >= 1) {
        pills.forEach((pill) => {
          if (pill.getAttribute("data-category-name") === activeCategoryPath[0]) {
            pill.setAttribute("data-active", "");
          }
        });
      }
    } else if (isArchive && !hasTag && !hasUncategorized) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__archive__"]')
        ?.setAttribute("data-active", "");
    }

    // 自动滚动到当前高亮的分类
    const activePill = bar.querySelector<HTMLAnchorElement>('.category-pill[data-active]');
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (activePill && scroll) {
      const scrollLeft = activePill.offsetLeft - scroll.offsetLeft - (scroll.clientWidth - activePill.offsetWidth) / 2;
      scroll.scrollTo({ left: Math.max(0, scrollLeft), behavior: "smooth" });
    }

    // 更新横幅标题：归档页有分类筛选时显示分类名
    if (isArchive && activeCategoryPath.length > 0) {
      const bannerTitle = document.querySelector(".banner-page-title-text");
      if (bannerTitle) {
        bannerTitle.textContent = activeCategoryPath.map(decodeURIComponent).join(" / ");
      }
    }
  }

  function initScrollFeatures() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (!scroll) return;

    // 鼠标滚轮横向滚动
    scroll.addEventListener("wheel", (e) => {
      if (scroll.scrollWidth <= scroll.clientWidth) return;
      e.preventDefault();
      scroll.scrollLeft += e.deltaY;
    }, { passive: false });

    // 监听滚动更新提示图标
    scroll.addEventListener("scroll", updateScrollHint);
    window.addEventListener("resize", updateScrollHint);
    updateScrollHint();
  }

  /**
   * Initialize dropdown interaction: hover (desktop) + click/tap (mobile).
   * - Hover a category pill → opens dropdown panel
   * - Click/tap a category pill → opens/toggles dropdown panel
   * - Click/tap tree-toggle button → expand/collapse branch
   * - Click a dropdown pill link → navigates normally
   */
  function initDropdownInteraction() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    let closeTimer: ReturnType<typeof setTimeout> | null = null;
    let currentDropdown: string | null = null;

    function showDropdown(name: string) {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      if (currentDropdown === name) return; // already showing
      currentDropdown = name;
      // Highlight hovered pill
      bar.querySelectorAll<HTMLElement>(".category-item").forEach((item) => {
        item.toggleAttribute("data-hovered", item.getAttribute("data-name") === name);
      });
      // Show matching dropdown content, hide others
      bar.querySelectorAll<HTMLElement>(".dropdown-content").forEach((dc) => {
        const isMatch = dc.getAttribute("data-dropdown") === name;
        dc.style.display = isMatch ? "block" : "none";
        if (isMatch) {
          // Auto-expand first-level tree nodes so 2nd-level children are visible
          dc.querySelectorAll<HTMLElement>(".dropdown-tree > .tree-node").forEach((node) => {
            node.setAttribute("data-expanded", "");
          });
        } else {
          // Reset expansion on hidden dropdowns
          dc.querySelectorAll<HTMLElement>(".tree-node[data-expanded]").forEach((node) => {
            node.removeAttribute("data-expanded");
          });
        }
      });
      bar.setAttribute("data-active-dropdown", name);
    }

    function hideDropdown() {
      closeTimer = setTimeout(() => {
        currentDropdown = null;
        bar.setAttribute("data-active-dropdown", "");
        bar.querySelectorAll<HTMLElement>(".category-item[data-hovered]").forEach((item) => {
          item.removeAttribute("data-hovered");
        });
        bar.querySelectorAll<HTMLElement>(".dropdown-content").forEach((dc) => {
          dc.style.display = "none";
          // Reset tree expansion
          dc.querySelectorAll<HTMLElement>(".tree-node[data-expanded]").forEach((node) => {
            node.removeAttribute("data-expanded");
          });
        });
        closeTimer = null;
      }, 200);
    }

    // Top-level category items: hover + click to open dropdown
    bar.querySelectorAll<HTMLElement>(".category-item").forEach((item) => {
      const name = item.getAttribute("data-name") || "";
      const hasChildren = item.querySelector(".has-children") !== null;
      if (!hasChildren) return;

      // Desktop hover
      item.addEventListener("mouseenter", () => showDropdown(name));
      item.addEventListener("mouseleave", () => hideDropdown());

      // Mobile click / desktop click: toggle dropdown
      const pill = item.querySelector<HTMLAnchorElement>(".category-pill");
      if (pill) {
        pill.addEventListener("click", (e) => {
          if (currentDropdown !== name) {
            e.preventDefault(); // don't navigate, open dropdown instead
            showDropdown(name);
          }
          // If already open, let the click navigate normally
        });
      }
    });

    // Dropdown panel: keep open while interacting
    const panel = bar.querySelector<HTMLElement>(".category-dropdown-panel");
    if (panel) {
      panel.addEventListener("mouseenter", () => {
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = null;
        }
      });
      panel.addEventListener("mouseleave", () => hideDropdown());
    }

    // Tree toggle buttons: expand/collapse branches
    bar.querySelectorAll<HTMLButtonElement>(".tree-toggle").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const node = btn.closest(".tree-node");
        if (node) {
          node.toggleAttribute("data-expanded");
        }
      });
    });
  }

  function updateScrollHint() {
    const bar = document.getElementById("category-bar");
    if (!bar) return;
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    const fadeLeft = bar.querySelector<HTMLElement>(".scroll-fade-left");
    const fadeRight = bar.querySelector<HTMLElement>(".scroll-fade-right");
    if (!scroll || !fadeLeft || !fadeRight) return;

    const hasOverflow = scroll.scrollWidth > scroll.clientWidth + 1;
    const atStart = scroll.scrollLeft <= 1;
    const atEnd = scroll.scrollLeft + scroll.clientWidth >= scroll.scrollWidth - 1;

    if (hasOverflow && !atStart) {
      fadeLeft.setAttribute("data-visible", "");
    } else {
      fadeLeft.removeAttribute("data-visible");
    }

    if (hasOverflow && !atEnd) {
      fadeRight.setAttribute("data-visible", "");
    } else {
      fadeRight.removeAttribute("data-visible");
    }
  }

  updateCategoryBar();
  initScrollFeatures();
  initDropdownInteraction();
  document.addEventListener("astro:page-load", () => {
    updateCategoryBar();
    initScrollFeatures();
    initDropdownInteraction();
  });
  document.addEventListener("swup:contentReplaced", () => {
    updateCategoryBar();
    initDropdownInteraction();
  });
</script>
